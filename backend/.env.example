# PostgreSQL connection string. Replace with your managed Postgres URL in production
# (Render/Railway/Supabase/RDS all provide one in this format).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trinetra_ai

# Secret used to sign JWT access tokens. Generate a long random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# n8n webhook URL from automation/My workflow.json (the "Webhook" node's
# production URL, once the workflow is active). Leave blank to disable
# alert notifications entirely.
N8N_WEBHOOK_URL=
